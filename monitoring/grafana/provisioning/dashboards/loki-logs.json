{
  "id": null,
  "uid": "loki-logs",
  "title": "Agregacija Logova (Loki)",
  "description": "Logovi svih mikroservisa sakupljeni kroz Promtail → Loki. Izaberi servis u padajućem meniju da vidiš samo njegove logove.",
  "tags": ["logs", "loki", "promtail", "soa-tourism"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Volume logova po servisu",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "sum(rate({job=\"docker\"}[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 5 } }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      }
    },
    {
      "id": 2,
      "title": "ERROR / WARN logovi — svih servisa",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [
        {
          "expr": "{job=\"docker\"} |~ \"(?i)(error|warn|exception|fatal)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 3,
      "title": "Logovi — izabrani servis ($service)",
      "type": "logs",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "description": "Prati $service dropdown iznad dashboarda (svaka replika tog servisa se pojavljuje ovde, deljenim service labelom)",
      "targets": [
        {
          "expr": "{service=\"$service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Servis",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "query": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  }
}
