{
  "id": null,
  "uid": "container-metrics",
  "title": "Container Metrics (cAdvisor)",
  "description": "CPU, RAM, fajl sistem i mrežni saobraćaj svih kontejnera",
  "tags": ["containers", "cadvisor", "docker", "soa-tourism"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU iskorišćenost po kontejneru (%)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"}[5m])) by (name) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 2,
      "title": "RAM iskorišćenost po kontejneru",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }
      }
    },
    {
      "id": 3,
      "title": "Top 5 kontejnera po RAM-u",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "topk(5, container_memory_usage_bytes{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 256000000 },
              { "color": "red", "value": 512000000 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "title": "Top 5 kontejnera po CPU-u",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "topk(5, sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"}[5m])) by (name) * 100)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "title": "Mrežni saobraćaj kontejnera — primljeno",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"}[5m])",
          "legendFormat": "↓ {{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 6,
      "title": "Mrežni saobraćaj kontejnera — poslano",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "rate(container_network_transmit_bytes_total{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"}[5m])",
          "legendFormat": "↑ {{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 7,
      "title": "Fajl sistem kontejnera — iskorišćeni prostor",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "container_fs_usage_bytes{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\",device!=\"\"}",
          "legendFormat": "{{name}} ({{device}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 1, "fillOpacity": 5 }
        }
      }
    },
    {
      "id": 8,
      "title": "Status kontejnera (pokrenutih)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        {
          "expr": "count(container_last_seen{container_label_com_docker_compose_project=\"soa-tourism\",name!=\"\"})",
          "legendFormat": "Pokrenuti kontejneri",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 9,
      "title": "Memorija po servisu — % od limita (kritično > 75%)",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Agregatno po servisu (zbir svih replika) u odnosu na deploy.resources.limits.memory iz docker-compose.yml",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_usage_bytes{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"}) / sum by (container_label_com_docker_compose_service) (container_spec_memory_limit_bytes{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"}) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 10,
      "title": "CPU po servisu — % od limita (kritično > 75%)",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Agregatno po servisu (zbir svih replika) u odnosu na deploy.resources.limits.cpus iz docker-compose.yml",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"}[2m])) / sum by (container_label_com_docker_compose_service) (container_spec_cpu_quota{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"} / container_spec_cpu_period{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"}) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 11,
      "title": "Broj instanci po servisu",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Trenutan broj repliki po servisu (docker compose up -d --scale <servis>=N)",
      "targets": [
        {
          "expr": "count by (container_label_com_docker_compose_service) (container_last_seen{container_label_com_docker_compose_project=\"soa-tourism\",container_label_com_docker_compose_service=~\"gateway|stakeholders|blog|followers|tours|encounters|payments\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 12,
      "title": "OOM-kill događaji po servisu",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Koliko je puta kernel OOM-killer ugasio kontejner ovog servisa u izabranom vremenskom opsegu — glavni signal pri load/overload testiranju",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (increase(container_oom_events_total{container_label_com_docker_compose_project=\"soa-tourism\"}[$__range]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 13,
      "title": "Restart / flap po servisu (promjene up/down statusa)",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 55 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "description": "Broj promjena up⇄down za /metrics scrape cilj svakog servisa (job=services) u izabranom opsegu — visok broj znači da servis stalno pada i diže se",
      "targets": [
        {
          "expr": "changes(up{job=\"services\"}[$__range])",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "pluginId": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 2
      }
    ]
  }
}
