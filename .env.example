# Copy this file to .env (which is gitignored) and fill in real values for
# anything beyond local-demo use. docker-compose.yml reads .env automatically.

# HS256 signing secret for stakeholders' access tokens. The service refuses
# to start without one — this default is fine for local docker-compose use
# only, never reuse it anywhere real.
JWT_SECRET=super-secret-change-me-123456
