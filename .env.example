# Copy this file to .env (which is gitignored) and fill in real values for
# anything beyond local-demo use. docker-compose.yml reads .env automatically.

# HS256 signing secret for stakeholders' access tokens. The service refuses
# to start without one — this default is fine for local docker-compose use
# only, never reuse it anywhere real.
#
# Must be at least 32 bytes (256 bits): HS256 requires a key of at least
# the hash output size (RFC 7518 §3.2). stakeholders (Go/golang-jwt) will
# happily sign tokens with a shorter secret without complaint, but payments
# (.NET/Microsoft.IdentityModel.Tokens) silently refuses to validate them
# against an under-sized key - every payments-authenticated request (the
# whole shopping-cart/checkout flow) then fails with 401 "signature key
# was not found", even though the secret matches byte-for-byte. Below is
# 64 bytes - comfortably over the minimum.
JWT_SECRET=d9HVsG6Hm-3_HpItCOJAcDZ2mk9L3kzUlbgdepMuGTwi6VB_lcSfG3iz1GggCdC_
